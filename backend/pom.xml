<resource><directory>src/main/resources</directory></resource>
<resource><directory>../frontend/dist</directory><targetPath>static</targetPath><filtering>false</filtering></resource>
</resources>
<plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>com.bridge.localverification.LocalVerificationApplication</mainClass></configuration></plugin></plugins>
</build></profile>
<profile><id>erasure-rehearsal</id><build>
<finalName>bridgego-synthetic-erasure-rehearsal</finalName>
<plugins>
<plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><skip>true</skip></configuration></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
<configuration combine.self="override"><includes>
<include>com/bridge/persistence/LocalSyntheticErasureRehearsal*</include>
<include>com/bridge/persistence/OperatorAccountErasure*</include>
<include>com/bridge/persistence/FinalMatchEnvelope*</include>
<include>com/bridge/persistence/ErasureLedger*</include>
<include>com/bridge/persistence/SheetsGateway*</include>
<include>com/bridge/persistence/SheetsStatsStore*</include>
