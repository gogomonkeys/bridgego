<modelVersion>4.0.0</modelVersion><parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.7</version><relativePath/></parent>
<groupId>com.bridge</groupId><artifactId>bridge-room-successor</artifactId><version>0.12.1</version><properties><java.version>17</java.version></properties>
<dependencies><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-websocket</artifactId></dependency><dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency></dependencies>
<build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>com.bridge.room.RoomApplication</mainClass></configuration></plugin>
<!-- Synthetic proof/fixtures never ship in the normal game, verification or operator JARs. -->
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><excludes><exclude>com/bridge/persistence/LocalSyntheticErasureRehearsal*</exclude><exclude>com/bridge/persistence/ManualQuarterMaintenance*</exclude><exclude>com/bridge/persistence/LocalManualQuarterRehearsal*</exclude><exclude>com/bridge/persistence/LiveQuarter*</exclude><exclude>com/bridge/persistence/SyntheticSheetsErasurePreparation*</exclude><exclude>com/bridge/persistence/SyntheticSheetsReadOnlyAdapter*</exclude><exclude>com/bridge/persistence/SyntheticSheetsReadOnlyTransport*</exclude></excludes></configuration></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><excludes><exclude>**/SyntheticSheetsReadOnlyTransport*.java</exclude><exclude>**/LiveQuarter*.java</exclude></excludes><testExcludes><testExclude>**/SyntheticSheetsReadOnlyTransport*.java</testExclude><testExclude>**/LiveQuarter*.java</testExclude></testExcludes></configuration></plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><excludes><exclude>**/SyntheticSheetsReadOnlyTransportTest*</exclude><exclude>**/LiveQuarter*Test*</exclude></excludes></configuration></plugin>
</plugins></build>
<!-- Build frontend first with scripts/build-production.*. Generated assets stay out of src. -->
<profiles><profile><id>web</id><build>
<finalName>bridgego-server</finalName>
<resources>
<resource><directory>src/main/resources</directory></resource>
<resource><directory>../frontend/dist</directory><targetPath>static</targetPath><filtering>false</filtering></resource>
</resources>
</build></profile><profile><id>operator-kit</id><build><finalName>bridgego-sheets-operator</finalName><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><mainClass>com.bridge.persistence.QuarterRetentionOperator</mainClass></configuration></plugin></plugins></build></profile><profile><id>local-verification-kit</id><build>
<finalName>bridgego-local-verification</finalName>
