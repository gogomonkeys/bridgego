<include>com/bridge/persistence/StatsStore*</include>
<include>com/bridge/persistence/QuarterlyRetention*</include>
<include>com/bridge/persistence/RetentionLedger*</include>
<include>com/bridge/room/GoogleCredentialVerifier*</include>
<include>com/bridge/room/IdentityStore*</include>
</includes><archive><manifest><mainClass>com.bridge.persistence.LocalSyntheticErasureRehearsal</mainClass></manifest></archive></configuration>
</plugin>
<plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
<!-- Build-only dependencies already present in the approved offline tool cache. -->
<dependencies>
<dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.27.1</version></dependency>
<dependency><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.17.1</version></dependency>
</dependencies>
<executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
<createDependencyReducedPom>false</createDependencyReducedPom>
<artifactSet><includes><include>com.fasterxml.jackson.core:*</include></includes></artifactSet>
<filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes></filter></filters>
<transformers combine.self="override"><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>com.bridge.persistence.LocalSyntheticErasureRehearsal</mainClass></transformer></transformers>
</configuration></execution></executions></plugin>
</plugins></build></profile>
